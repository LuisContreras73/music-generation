{
  "name": "lstm",
  "model": "lstm",
  "family": "token",
  "seed": 1234,
  "notes": "Linea base recurrente: LSTM 3x1024 sobre tokens de evento. Muestreo O(1) por token gracias al estado recurrente.",
  "seq_len": 1024,
  "batch_size": 24,
  "grad_accum": 1,
  "num_workers": 6,
  "train_windows": 200000,
  "val_windows": 400,
  "d_model": 512,
  "n_layers": 3,
  "n_heads": 8,
  "d_ff": 2048,
  "dropout": 0.1,
  "attn_dropout": 0.0,
  "rel_attn": true,
  "max_rel_dist": 512,
  "hidden": 1024,
  "latent_dim": 64,
  "flux_weight": 0.1,
  "kl_weight": 0.001,
  "tie_weights": true,
  "steps": 4900,
  "lr": 0.001,
  "min_lr_frac": 0.05,
  "warmup": 400,
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "amp": "bf16",
  "compile_model": false,
  "label_smoothing": 0.0,
  "eval_every": 500,
  "log_every": 50,
  "gen_every": 1500,
  "n_gen_samples": 16,
  "gen_steps": 800,
  "gen_prime_steps": 200,
  "temperature": 1.0,
  "top_k": 0,
  "top_p": 0.95
}