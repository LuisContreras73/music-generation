  "aug_stretch_hi": 2.0,
  "aug_p_thin": 0.5,
  "aug_thin_lo": 0.85,
  "aug_thin_hi": 1.0,
  "aug_p_jitter": 0.1,
  "d_model": 512,
  "n_layers": 8,
  "n_heads": 8,
  "d_ff": 2048,
